{
  "name": "folioweave",
  "version": "1.0.0",
  "private": true,
  "description": "FolioWeave — a pixel-faithful, reusable Next.js portfolio theme with deterministic regression QA.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kukutx/folioweave.git"
  },
  "bugs": {
    "url": "https://github.com/Kukutx/folioweave/issues"
  },
  "keywords": [
    "nextjs",
    "portfolio",
    "template",
    "theme",
    "typescript",
    "framer-motion",
    "design-portfolio"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "analyze": "next experimental-analyze --output",
    "qa:assets": "node qa/assets.mjs",
    "qa:functionality": "node qa/functionality.mjs",
    "qa:quality": "node qa/quality.mjs",
    "qa:media": "node qa/media-health.mjs",
    "qa:fonts": "node qa/font-fallback-test.mjs",
    "qa:bundle": "node qa/bundle-budget.mjs",
    "qa:resume": "node qa/resume-parity.mjs",
    "qa:static": "node qa/static-home-parity.mjs",
    "qa:parity": "node --expose-gc qa/parity.mjs",
    "qa:core": "npm run qa:assets && npm run qa:functionality && npm run qa:quality && npm run qa:media",
    "qa:all": "node qa/run-with-server.mjs qa:assets qa:functionality qa:quality qa:media qa:fonts qa:resume qa:bundle",
    "qa:reference": "node qa/run-with-server.mjs qa:static qa:parity",
    "qa:maintainer": "npm run qa:all && npm run qa:reference",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "framer-motion": "13.1.1",
    "lenis": "1.3.26",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.62.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "motion-dom": "13.1.1",
    "motion-utils": "13.0.0"
  }
}
