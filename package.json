{
  "name": "folioweave",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A polished, production-ready Next.js portfolio starter for designers, developers, and creative professionals.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kukutx/folioweave.git"
  },
  "bugs": {
    "url": "https://github.com/Kukutx/folioweave/issues"
  },
  "keywords": [
    "nextjs",
    "portfolio",
    "template",
    "theme",
    "typescript",
    "framer-motion",
    "design-portfolio"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format:styles": "prettier --write \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run build",
    "analyze": "next experimental-analyze --output",
    "qa:assets": "node qa/assets.mjs",
    "qa:functionality": "node qa/functionality.mjs",
    "qa:quality": "node qa/quality.mjs",
    "qa:media": "node qa/media-health.mjs",
    "qa:fonts": "node qa/font-fallback-test.mjs",
    "qa:css": "node qa/css-contract.mjs",
    "qa:bundle": "node qa/bundle-budget.mjs",
    "qa:resume": "node qa/resume-state.mjs",
    "qa:boundary": "node scripts/branch-boundary-check.mjs && node --test qa/demo-boundary.test.mjs qa/profile-boundary.test.mjs",
    "qa:visual-integrity": "node qa/visual-integrity.mjs",
    "qa:visual-classic": "node qa/visual-integrity.mjs --classic-scrollbars",
    "qa:visual-fixtures": "node qa/visual-fixtures.mjs",
    "qa:core": "npm run qa:boundary && npm run qa:css && npm run qa:assets && npm run qa:functionality && npm run qa:quality && npm run qa:media",
    "qa:all": "node qa/run-with-server.mjs qa:runtime:direct qa:ownership qa:css qa:assets qa:functionality qa:quality qa:weather qa:media qa:fonts qa:resume qa:bundle qa:gallery-loading qa:visual-integrity qa:visual-classic qa:lifecycle",
    "qa:maintainer": "npm run qa:all && npm run qa:visual-fixtures && npm run qa:profiles && npm run qa:visual-compare && node qa/run-with-server.mjs qa:browsers",
    "qa:lifecycle": "node --test qa/scroll-lock.test.mjs && node qa/interaction-lifecycle.mjs && node qa/parallax-lifecycle.mjs",
    "qa:runtime": "node qa/run-with-server.mjs qa:runtime:direct",
    "qa:runtime:direct": "node qa/runtime-budget.mjs",
    "qa:runtime-trace": "node qa/run-with-server.mjs qa:runtime-trace:direct",
    "qa:runtime-trace:direct": "node qa/runtime-budget.mjs --trace",
    "qa:runtime-trace-normal": "node qa/run-with-server.mjs qa:runtime-trace-normal:direct",
    "qa:runtime-trace-normal:direct": "node qa/runtime-budget.mjs --trace --motion=normal",
    "qa:runtime-trace-mobile": "node qa/run-with-server.mjs qa:runtime-trace-mobile:direct",
    "qa:runtime-trace-mobile:direct": "node qa/runtime-budget.mjs --trace --motion=normal --viewport=mobile",
    "qa:runtime-diagnostic": "node qa/run-with-server.mjs qa:runtime-diagnostic:direct",
    "qa:runtime-diagnostic:direct": "node qa/runtime-budget.mjs --diagnostic",
    "qa:runtime-diagnostic-mobile": "node qa/run-with-server.mjs qa:runtime-diagnostic-mobile:direct",
    "qa:runtime-diagnostic-mobile:direct": "node qa/runtime-budget.mjs --diagnostic --viewport=mobile",
    "qa:runtime-diagnostic-normal": "node qa/run-with-server.mjs qa:runtime-diagnostic-normal:direct",
    "qa:runtime-diagnostic-normal:direct": "node qa/runtime-budget.mjs --diagnostic --motion=normal",
    "qa:runtime-diagnostic-native": "node qa/run-with-server.mjs qa:runtime-diagnostic-native:direct",
    "qa:runtime-diagnostic-native:direct": "node qa/runtime-budget.mjs --diagnostic --motion=normal --profile=native",
    "audit:prod": "npm audit --omit=dev",
    "qa:visual-compare": "node qa/run-with-server.mjs qa:regression-check",
    "personalize": "node scripts/personalize.mjs",
    "content:test": "node --test qa/content-core.test.mjs qa/publication-policy.test.mjs qa/content-pipeline.test.mjs qa/route-contract.test.mjs qa/weather.test.mjs qa/visual-contract.test.mjs",
    "content:check": "npm run content:test && node scripts/portfolio-check.mjs",
    "content:build": "node scripts/content-build.mjs",
    "prebuild": "npm run qa:boundary && npm run content:build && npm run content:check",
    "qa:visual-baseline": "node qa/run-with-server.mjs qa:regression-capture",
    "qa:ownership": "node qa/browser-ownership.mjs",
    "qa:profiles": "node qa/visual-fixtures.mjs --minimal-home",
    "qa:weather": "node qa/weather-states.mjs",
    "qa:gallery-loading": "node qa/gallery-loading.mjs",
    "qa:upstream": "node qa/run-with-server.mjs qa:upstream-check",
    "qa:upstream-check": "node qa/upstream-health.mjs",
    "qa:browsers": "node qa/cross-browser.mjs",
    "qa:regression-check": "node qa/visual-integrity.mjs --regression",
    "qa:regression-capture": "node qa/visual-integrity.mjs --update-regression"
  },
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "fast-xml-parser": "5.11.1",
    "framer-motion": "13.2.0",
    "gray-matter": "4.0.3",
    "lenis": "1.3.26",
    "lucide-react": "1.39.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.4",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "json-schema-to-typescript": "16.0.0",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.62.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
