    "story": [
      [
        {
          "tone": "strong",
          "text": "I'm Liu Zhong Li, a full-stack software developer based in Milan. "
        },
        {
          "tone": "muted",
          "text": "I started professionally on the frontend, then kept getting curious about everything that happened beyond the screen."
        }
      ],
      [
        {
          "tone": "muted",
          "text": "That curiosity took me from Angular, WordPress and Drupal into "
        },
        {
          "tone": "strong",
          "text": ".NET backends, React / Next.js, Flutter and PostgreSQL"
        },
        {
          "tone": "muted",
          "text": ". I enjoy being able to follow a product across those boundaries instead of stopping at one layer."
        }
      ],
      [
        {
          "tone": "muted",
          "text": "The project that really changed how I work is "
        },
        {
          "tone": "highlight",
          "text": "Crew"
        },
        {
          "tone": "muted",
          "text": ". Building it independently meant owning the product decisions, UI, app, backend, data, cloud and releases — and learning whatever the next problem required."
        }
      ],
      [
        {
          "tone": "muted",
          "text": "Then came "
        },
        {
          "tone": "strong",
          "text": "DevMate"
        },
        {
          "tone": "muted",
          "text": ". I wanted ChatGPT to work with my real local projects instead of snippets pasted into a chat, so I built the bridge I wanted to use myself."
        }
      ]
    ],
