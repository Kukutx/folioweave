{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FolioWeave Portfolio Configuration",
  "description": "Single-source content and personalization configuration for FolioWeave.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "features",
    "hero",
    "about",
    "projects",
    "photography",
    "blog",
    "footerBook",
    "seo",
    "interlude"
  ],
  "$defs": {
    "localPath": {
      "type": "string",
      "pattern": "^/(?!/)(?!.*//)[^\\\\\\s?#%:]*$"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{3,8}$"
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "$ref": "#/$defs/localImage"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "richTextSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brand"
          ],
          "properties": {
            "brand": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "icon"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "icon": {
                  "$ref": "#/$defs/localImage"
                }
              }
            }
          }
        }
      ]
    },
    "projectImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "$ref": "#/$defs/localImage",
          "description": "Default project artwork used on desktop and as the mobile fallback."
        },
        "mobile": {
          "$ref": "#/$defs/localImage",
          "description": "Optional mobile-specific override. Omit it to reuse src."
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "projectCarouselImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "$ref": "#/$defs/localImage",
          "description": "Default carousel slide used on desktop and as the mobile fallback."
        },
        "mobile": {
          "$ref": "#/$defs/localImage",
          "description": "Optional mobile-specific override for this same slide."
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectMedia": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "image": {
              "$ref": "#/$defs/projectImage"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "images"
          ],
          "properties": {
            "kind": {
              "const": "carousel"
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/projectCarouselImage"
              }
            }
          }
        }
      ]
    },
    "projectAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "description": "Internal path beginning with / or an absolute http(s) URL."
        },
        "icon": {
          "enum": [
            "arrow",
            "book"
          ]
        },
        "tone": {
          "enum": [
            "default",
            "accent"
          ],
          "description": "Use accent for secondary/editorial links; default for normal links."
        },
        "newTab": {
          "type": "boolean",
          "description": "Overrides link behavior. External links open in a new tab by default; internal links stay in the current tab."
        }
      }
    },
    "projectBadge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "tone"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "enum": [
            "gold",
            "blue"
          ],
          "description": "Visual badge style."
        },
        "href": {
          "type": "string"
        },
        "previewImage": {
          "$ref": "#/$defs/localImage",
          "description": "Optional local image shown as a hover preview."
        },
        "previewMaxWidth": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "projectStory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "image",
        "imageAlt",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/localImage"
        },
        "imageAlt": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "mobileTreatment",
        "name",
        "date",
        "description",
        "media"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable lowercase slug used as the React key. Must be unique."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this project appears in the Work section."
        },
        "mobileTreatment": {
          "enum": [
            "standard",
            "featured"
          ],
          "description": "Controls only the mobile card treatment; media kind and editorial story are modeled independently."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/localImage"
        },
        "media": {
          "$ref": "#/$defs/projectMedia",
          "description": "Discriminated image or carousel media. Legacy image/carouselImages fields are intentionally unsupported."
        },
        "badge": {
          "$ref": "#/$defs/projectBadge",
          "description": "Optional award/press badge displayed near project metadata."
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectAction"
          },
          "description": "Project links such as case studies, store pages, stories, or external sites."
        },
        "story": {
          "$ref": "#/$defs/projectStory",
          "description": "Optional editorial story block, independent from the card's media and mobile treatment."
        }
      }
    },
    "localImage": {
      "allOf": [
        {
          "$ref": "#/$defs/localPath"
        },
        {
          "pattern": "\\.(avif|gif|jpe?g|png|webp|svg)$"
        }
      ]
    },
    "localPdf": {
      "allOf": [
        {
          "$ref": "#/$defs/localPath"
        },
        {
          "pattern": "\\.pdf$"
        }
      ]
    },
    "localIcon": {
      "allOf": [
        {
          "$ref": "#/$defs/localPath"
        },
        {
          "pattern": "\\.(avif|gif|jpe?g|png|webp|svg|ico)$"
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "origin",
        "themeColor",
        "copyrightYear",
        "contact",
        "socialLinks",
        "navigation",
        "location",
        "resume",
        "assets"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "firstName",
            "initials",
            "role",
            "company",
            "locale"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "firstName": {
              "type": "string",
              "minLength": 1
            },
            "initials": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "company": {
              "type": "string",
              "description": "Optional company or studio name. Leave empty for independent/freelance portfolios."
            },
            "locale": {
              "type": "string",
              "minLength": 2,
              "description": "BCP 47 locale such as en-US, en-GB, it-IT, or zh-CN."
            }
          },
          "description": "Public identity used across the hero, metadata, structured data, and contact surfaces."
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Canonical production URL, for example https://example.com."
        },
        "themeColor": {
          "$ref": "#/$defs/hexColor"
        },
        "copyrightYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2200
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email",
            "helloSubject",
            "hiSubject"
          ],
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "helloSubject": {
              "type": "string"
            },
            "hiSubject": {
              "type": "string"
            }
          }
        },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "icon",
              "href",
              "brand"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "enum": [
                  "twitter",
                  "linkedin",
                  "instagram",
                  "github",
                  "email",
                  "website"
                ]
              },
              "href": {
                "type": "string",
                "minLength": 1
              },
              "brand": {
                "$ref": "#/$defs/hexColor"
              }
            }
          },
          "description": "Footer/profile social links. Remove entries you do not use."
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "href",
              "sectionId"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "sectionId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "newTab": {
                "type": "boolean"
              },
              "demoOnly": {
                "type": "boolean",
                "description": "Hide this navigation item when features.demoRoutes is false."
              }
            }
          },
          "description": "Navigation definitions. Section links are automatically hidden when their feature is disabled."
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "city",
            "country",
            "timeZone",
            "timeZoneLabel",
            "latitude",
            "longitude"
          ],
          "properties": {
            "city": {
              "type": "string",
              "minLength": 1
            },
            "country": {
              "type": "string",
              "minLength": 1
            },
            "timeZone": {
              "type": "string",
              "minLength": 1
            },
            "timeZoneLabel": {
              "type": "string",
              "minLength": 1
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "pdf",
            "downloadName"
          ],
          "properties": {
            "image": {
              "$ref": "#/$defs/localImage"
            },
            "pdf": {
              "$ref": "#/$defs/localPdf"
            },
            "downloadName": {
              "type": "string",
              "pattern": "\\.pdf$"
            }
          },
          "description": "Author resume files and download name. Referenced source files must exist even when the feature is disabled; disabled resume files are excluded from publication unless another published item references them."
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "socialPreview",
            "icon",
            "appleTouchIcon"
          ],
          "properties": {
            "socialPreview": {
              "$ref": "#/$defs/localImage",
              "description": "Local Open Graph/social preview asset under public/. Prefer a 1200x630 PNG, JPEG, or WebP for broad crawler compatibility."
            },
            "icon": {
              "$ref": "#/$defs/localIcon",
              "description": "Primary browser/favicon asset under public/. Clean mode uses a neutral SVG placeholder until you replace it."
            },
            "appleTouchIcon": {
              "$ref": "#/$defs/localImage",
              "description": "Apple touch icon under public/. Prefer a 180x180 PNG before publishing."
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weather",
        "about",
        "work",
        "photography",
        "resume",
        "demoRoutes"
      ],
      "properties": {
        "weather": {
          "type": "boolean",
          "description": "Show weather next to local time and enable /api/weather."
        },
        "about": {
          "type": "boolean",
          "description": "Render the About section and its navigation entry."
        },
        "work": {
          "type": "boolean",
          "description": "Render enabled projects and the Work navigation entry."
        },
        "photography": {
          "type": "boolean",
          "description": "Render the photography gallery and its navigation entry."
        },
        "resume": {
          "type": "boolean",
          "description": "Enable the interactive resume printer and require configured resume files."
        },
        "demoRoutes": {
          "type": "boolean",
          "description": "Expose bundled example detail/blog/privacy routes and the demo-only podcast API."
        }
      },
      "description": "Feature switches for optional homepage sections and bundled example routes."
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "greetings",
        "portraits",
        "roleLine",
        "summary"
      ],
      "properties": {
        "greetings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "portraits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/localImage"
          },
          "description": "One or more local portrait images. Clicking the hero card rotates through them."
        },
        "roleLine": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/richTextSegment"
          },
          "description": "Rich inline hero role line. Segments can be plain text or a brand with icon."
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/richTextSegment"
          },
          "description": "Rich inline hero summary. Segments can be plain text or a brand with icon."
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline",
        "story",
        "galleryImages"
      ],
      "properties": {
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "title",
              "desc"
            ],
            "properties": {
              "year": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              },
              "current": {
                "type": "boolean",
                "description": "Explicit current role; independent of the calendar year."
              }
            }
          }
        },
        "story": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tone",
                "text"
              ],
              "properties": {
                "tone": {
                  "enum": [
                    "muted",
                    "strong",
                    "highlight"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        },
        "galleryImages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaAsset"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "description": "Ordered project list. Add, remove, reorder, or disable projects without editing React components."
    },
    "photography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro",
        "images"
      ],
      "properties": {
        "intro": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaAsset"
          }
        }
      }
    },
    "blog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "footerBook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "quote",
        "author"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "keywords",
        "knowsAbout",
        "caseStudiesDescription"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Primary site description used for metadata, Open Graph, Twitter, Manifest, and Person JSON-LD."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Search keywords for the root portfolio page."
        },
        "knowsAbout": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Topics included in Person structured data."
        },
        "award": {
          "type": "string",
          "description": "Optional personal/site award. Remove when not applicable."
        },
        "caseStudiesDescription": {
          "type": "string"
        }
      },
      "description": "Root metadata and structured-data content derived into Next.js SEO outputs."
    },
    "interlude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "returnTitle",
        "handwrittenTitle",
        "returnDescription",
        "image"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "returnTitle": {
          "type": "string",
          "minLength": 1
        },
        "handwrittenTitle": {
          "type": "string",
          "minLength": 1
        },
        "returnDescription": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/$defs/localImage"
        }
      }
    }
  }
}
