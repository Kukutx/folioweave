{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FolioWeave Portfolio Configuration",
  "description": "Single-source content and personalization configuration for FolioWeave.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "features",
    "hero",
    "about",
    "projects",
    "photography",
    "footerBook",
    "seo"
  ],
  "$defs": {
    "localPath": {
      "type": "string",
      "pattern": "^/"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{3,8}$"
    },
    "imageSize": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "richTextSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brand"
          ],
          "properties": {
            "brand": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "icon"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "icon": {
                  "$ref": "#/$defs/localPath"
                }
              }
            }
          }
        }
      ]
    },
    "projectImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktop",
        "mobile",
        "alt"
      ],
      "properties": {
        "desktop": {
          "$ref": "#/$defs/localPath"
        },
        "mobile": {
          "$ref": "#/$defs/localPath"
        },
        "alt": {
          "type": "string"
        },
        "desktopSize": {
          "$ref": "#/$defs/imageSize",
          "description": "Optional intrinsic [width, height] for desktop artwork. Positive integers only."
        },
        "mobileSize": {
          "$ref": "#/$defs/imageSize",
          "description": "Optional intrinsic [width, height] for mobile artwork. Positive integers only."
        }
      }
    },
    "projectAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "description": "Internal path beginning with / or an absolute http(s) URL."
        },
        "icon": {
          "enum": [
            "arrow",
            "book"
          ]
        },
        "tone": {
          "enum": [
            "default",
            "accent"
          ],
          "description": "Use accent for secondary/editorial links; default for normal links."
        }
      }
    },
    "projectBadge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "tone"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "enum": [
            "gold",
            "blue"
          ],
          "description": "Visual badge style."
        },
        "href": {
          "type": "string"
        },
        "previewImage": {
          "$ref": "#/$defs/localPath",
          "description": "Optional local image shown as a hover preview."
        },
        "previewMaxWidth": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "projectStory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "image",
        "imageAlt",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/localPath"
        },
        "imageAlt": {
          "type": "string"
        },
        "imageSize": {
          "$ref": "#/$defs/imageSize"
        },
        "body": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "layout",
        "name",
        "date",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable lowercase slug used as the React key. Must be unique."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this project appears in the Work section."
        },
        "layout": {
          "enum": [
            "standard",
            "featured",
            "story",
            "carousel"
          ],
          "description": "standard: normal card; featured: inset mobile-friendly card; story: adds an editorial story block; carousel: uses carouselImages instead of a single image."
        },
        "featuredOnMobile": {
          "type": "boolean",
          "description": "Keeps the project image inset on mobile instead of using the wider edge treatment."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/localPath"
        },
        "image": {
          "$ref": "#/$defs/projectImage",
          "description": "Responsive desktop/mobile work artwork for standard, featured, or story layouts."
        },
        "carouselImages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localPath"
          },
          "description": "Slides used when layout is carousel."
        },
        "badge": {
          "$ref": "#/$defs/projectBadge",
          "description": "Optional award/press badge displayed near project metadata."
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectAction"
          },
          "description": "Project links such as case studies, store pages, stories, or external sites."
        },
        "story": {
          "$ref": "#/$defs/projectStory",
          "description": "Optional editorial story block. Recommended when layout is story."
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "origin",
        "themeColor",
        "copyrightYear",
        "contact",
        "socialLinks",
        "navigation",
        "location",
        "resume",
        "assets"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "firstName",
            "initials",
            "role",
            "company",
            "locale"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "firstName": {
              "type": "string",
              "minLength": 1
            },
            "initials": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "company": {
              "type": "string",
              "description": "Optional company or studio name. Leave empty for independent/freelance portfolios."
            },
            "locale": {
              "type": "string",
              "minLength": 2,
              "description": "BCP 47 locale such as en-US, en-GB, it-IT, or zh-CN."
            }
          },
          "description": "Public identity used across the hero, metadata, structured data, and contact surfaces."
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Canonical production URL, for example https://example.com."
        },
        "themeColor": {
          "$ref": "#/$defs/hexColor"
        },
        "copyrightYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2200
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email",
            "helloSubject",
            "hiSubject"
          ],
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "helloSubject": {
              "type": "string"
            },
            "hiSubject": {
              "type": "string"
            }
          }
        },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "icon",
              "href",
              "brand"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "enum": [
                  "twitter",
                  "linkedin",
                  "instagram",
                  "github",
                  "email",
                  "website"
                ]
              },
              "href": {
                "type": "string",
                "minLength": 1
              },
              "brand": {
                "$ref": "#/$defs/hexColor"
              }
            }
          },
          "description": "Footer/profile social links. Remove entries you do not use."
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "href",
              "sectionId"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "sectionId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "newTab": {
                "type": "boolean"
              },
              "demoOnly": {
                "type": "boolean",
                "description": "Hide this navigation item when features.demoRoutes is false."
              }
            }
          },
          "description": "Navigation definitions. Section links are automatically hidden when their feature is disabled."
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "city",
            "country",
            "timeZone",
            "timeZoneLabel",
            "latitude",
            "longitude"
          ],
          "properties": {
            "city": {
              "type": "string",
              "minLength": 1
            },
            "country": {
              "type": "string",
              "minLength": 1
            },
            "timeZone": {
              "type": "string",
              "minLength": 1
            },
            "timeZoneLabel": {
              "type": "string",
              "minLength": 1
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "pdf",
            "downloadName"
          ],
          "properties": {
            "image": {
              "$ref": "#/$defs/localPath"
            },
            "pdf": {
              "$ref": "#/$defs/localPath"
            },
            "downloadName": {
              "type": "string",
              "pattern": "\\.pdf$"
            }
          },
          "description": "Resume files and download name. Files are only required when the resume feature is enabled."
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "socialPreview",
            "icon",
            "appleTouchIcon"
          ],
          "properties": {
            "socialPreview": {
              "$ref": "#/$defs/localPath",
              "description": "Local Open Graph/social preview asset under public/. Prefer a 1200x630 PNG, JPEG, or WebP for broad crawler compatibility."
            },
            "icon": {
              "$ref": "#/$defs/localPath",
              "description": "Primary browser/favicon asset under public/. Clean mode uses a neutral SVG placeholder until you replace it."
            },
            "appleTouchIcon": {
              "$ref": "#/$defs/localPath",
              "description": "Apple touch icon under public/. Prefer a 180x180 PNG before publishing."
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weather",
        "about",
        "work",
        "photography",
        "resume",
        "demoRoutes"
      ],
      "properties": {
        "weather": {
          "type": "boolean",
          "description": "Show weather next to local time and enable /api/weather."
        },
        "about": {
          "type": "boolean",
          "description": "Render the About section and its navigation entry."
        },
        "work": {
          "type": "boolean",
          "description": "Render enabled projects and the Work navigation entry."
        },
        "photography": {
          "type": "boolean",
          "description": "Render the photography gallery and its navigation entry."
        },
        "resume": {
          "type": "boolean",
          "description": "Enable the interactive resume printer and require configured resume files."
        },
        "demoRoutes": {
          "type": "boolean",
          "description": "Expose bundled example detail/blog/privacy routes and the demo-only podcast API."
        }
      },
      "description": "Feature switches for optional homepage sections and bundled example routes."
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "greetings",
        "portraits",
        "roleLine",
        "summary"
      ],
      "properties": {
        "greetings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "portraits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/localPath"
          },
          "description": "One or more local portrait images. Clicking the hero card rotates through them."
        },
        "roleLine": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/richTextSegment"
          },
          "description": "Rich inline hero role line. Segments can be plain text or a brand with icon."
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/richTextSegment"
          },
          "description": "Rich inline hero summary. Segments can be plain text or a brand with icon."
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline",
        "story",
        "galleryImages"
      ],
      "properties": {
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "title",
              "desc"
            ],
            "properties": {
              "year": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            }
          }
        },
        "story": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tone",
                "text"
              ],
              "properties": {
                "tone": {
                  "enum": [
                    "muted",
                    "strong",
                    "highlight"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        },
        "galleryImages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localPath"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "description": "Ordered project list. Add, remove, reorder, or disable projects without editing React components."
    },
    "photography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro",
        "images"
      ],
      "properties": {
        "intro": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localPath"
          }
        }
      }
    },
    "footerBook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "quote",
        "author"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "keywords",
        "knowsAbout",
        "caseStudiesDescription"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Primary site description used for metadata, Open Graph, Twitter, Manifest, and Person JSON-LD."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Search keywords for the root portfolio page."
        },
        "knowsAbout": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Topics included in Person structured data."
        },
        "award": {
          "type": "string",
          "description": "Optional personal/site award. Remove when not applicable."
        },
        "caseStudiesDescription": {
          "type": "string"
        }
      },
      "description": "Root metadata and structured-data content derived into Next.js SEO outputs."
    }
  }
}
