{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FolioWeave Portfolio Configuration",
  "description": "Single-source content and personalization configuration for FolioWeave.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "description": "The resume's files are required while the resume is shown.",
      "if": {
        "required": ["features"],
        "properties": {
          "features": {
            "required": ["resume"],
            "properties": { "resume": { "const": true } }
          }
        }
      },
      "then": {
        "properties": { "site": { "required": ["resume"] } }
      }
    }
  ],
  "required": [
    "site",
    "features",
    "hero",
    "about",
    "projects",
    "blog",
    "seo"
  ],
  "$defs": {
    "hostingOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/]+$",
      "description": "The site's address on this host, used for canonical links, the sitemap and social cards in builds for it; site.origin when omitted."
    },
    "localPath": {
      "type": "string",
      "pattern": "^/(?!/)(?!.*//)[^\\\\\\s?#%:]*$"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{3,8}$"
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "$ref": "#/$defs/localImage"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "richTextSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brand"
          ],
          "properties": {
            "brand": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "icon"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "icon": {
                  "$ref": "#/$defs/localImage"
                },
                "project": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Optional id of a Work project. The brand becomes a link that scrolls to that project."
                }
              }
            }
          }
        }
      ]
    },
    "projectImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "$ref": "#/$defs/localImage",
          "description": "Default project artwork used on desktop and as the mobile fallback."
        },
        "mobile": {
          "$ref": "#/$defs/localImage",
          "description": "Optional mobile-specific override. Omit it to reuse src."
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "projectCarouselImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "$ref": "#/$defs/localImage",
          "description": "Default carousel slide used on desktop and as the mobile fallback."
        },
        "mobile": {
          "$ref": "#/$defs/localImage",
          "description": "Optional mobile-specific override for this same slide."
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectMedia": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "image": {
              "$ref": "#/$defs/projectImage"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "images"
          ],
          "properties": {
            "kind": {
              "const": "carousel"
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/projectCarouselImage"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "screens"
          ],
          "properties": {
            "kind": {
              "const": "screens"
            },
            "screens": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/mediaAsset"
              },
              "description": "App screenshots in display order, one image per screen. Every width shows the same screens in the same order: three side by side where there is room, two in a narrow column, and any further screens scroll in sideways."
            },
            "frame": {
              "enum": [
                "phone",
                "none"
              ],
              "default": "phone",
              "description": "Frame drawn around each screenshot: a phone bezel, or none for screenshots that already include their device or window."
            }
          }
        }
      ]
    },
    "projectAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "description": "Internal path beginning with / or an absolute http(s) URL."
        },
        "icon": {
          "enum": [
            "arrow",
            "book"
          ]
        },
        "tone": {
          "enum": [
            "default",
            "accent"
          ],
          "description": "Use accent for secondary/editorial links; default for normal links."
        },
        "newTab": {
          "type": "boolean",
          "description": "Overrides link behavior. External links open in a new tab by default; internal links stay in the current tab."
        }
      }
    },
    "projectBadge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "tone"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "enum": [
            "gold",
            "blue"
          ],
          "description": "Visual badge style."
        },
        "href": {
          "type": "string"
        },
        "previewImage": {
          "$ref": "#/$defs/localImage",
          "description": "Optional local image shown as a hover preview."
        },
        "previewMaxWidth": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "projectStory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "image",
        "imageAlt",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/localImage"
        },
        "imageAlt": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "mobileTreatment",
        "name",
        "date",
        "description",
        "media"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable lowercase slug used as the React key. Must be unique."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this project appears in the Work section."
        },
        "mobileTreatment": {
          "enum": [
            "standard",
            "featured"
          ],
          "description": "Controls only the mobile card treatment; media kind and editorial story are modeled independently."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/localImage"
        },
        "media": {
          "$ref": "#/$defs/projectMedia",
          "description": "Discriminated image, carousel or screens media. Legacy image/carouselImages fields are intentionally unsupported."
        },
        "badge": {
          "$ref": "#/$defs/projectBadge",
          "description": "Optional award/press badge displayed near project metadata."
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectAction"
          },
          "description": "Project links such as case studies, store pages, stories, or external sites."
        },
        "story": {
          "$ref": "#/$defs/projectStory",
          "description": "Optional editorial story block, independent from the card's media and mobile treatment."
        }
      }
    },
    "localImage": {
      "allOf": [
        {
          "$ref": "#/$defs/localPath"
        },
        {
          "pattern": "\\.(avif|gif|jpe?g|png|webp|svg)$"
        }
      ]
    },
    "localPdf": {
      "allOf": [
        {
          "$ref": "#/$defs/localPath"
        },
        {
          "pattern": "\\.pdf$"
        }
      ]
    },
    "localDocx": {
      "allOf": [
        {
          "$ref": "#/$defs/localPath"
        },
        {
          "pattern": "\\.docx$"
        }
      ]
    },
    "localIcon": {
      "allOf": [
        {
          "$ref": "#/$defs/localPath"
        },
        {
          "pattern": "\\.(avif|gif|jpe?g|png|webp|svg|ico)$"
        }
      ]
    },
    "storeLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "pattern": "^(https://|mailto:|tel:|/(?!/))[^\\s\\\\]*$"
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "origin",
        "themeColor",
        "copyrightYear",
        "socialLinks",
        "navigation",
        "location",
        "assets"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "firstName",
            "initials",
            "role",
            "company",
            "locale"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "firstName": {
              "type": "string",
              "minLength": 1
            },
            "initials": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "company": {
              "type": "string",
              "description": "Optional company or studio name. Leave empty for independent/freelance portfolios."
            },
            "locale": {
              "type": "string",
              "minLength": 2,
              "description": "BCP 47 locale such as en-US, en-GB, it-IT, or zh-CN."
            }
          },
          "description": "Public identity used across the hero, metadata, structured data, and contact surfaces."
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Canonical production URL, for example https://example.com."
        },
        "themeColor": {
          "$ref": "#/$defs/hexColor"
        },
        "copyrightYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2200
        },
        "contact": {
          "type": "object",
          "description": "An email address for templates that show one; they list site.contact under requires. A shop with no email leaves it out.",
          "additionalProperties": false,
          "required": [
            "email",
            "helloSubject",
            "hiSubject"
          ],
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "helloSubject": {
              "type": "string"
            },
            "hiSubject": {
              "type": "string"
            }
          }
        },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "icon",
              "href",
              "brand"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "enum": [
                  "twitter",
                  "linkedin",
                  "instagram",
                  "github",
                  "email",
                  "website"
                ]
              },
              "href": {
                "type": "string",
                "minLength": 1
              },
              "brand": {
                "$ref": "#/$defs/hexColor"
              }
            }
          },
          "description": "Footer/profile social links. Remove entries you do not use."
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "href",
              "sectionId"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "sectionId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "newTab": {
                "type": "boolean"
              },
              "demoOnly": {
                "type": "boolean",
                "description": "Hide this navigation item when features.demoRoutes is false."
              }
            }
          },
          "description": "Navigation definitions. Section links are automatically hidden when their feature is disabled."
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "city",
            "country",
            "timeZone",
            "timeZoneLabel",
            "latitude",
            "longitude"
          ],
          "properties": {
            "city": {
              "type": "string",
              "minLength": 1
            },
            "country": {
              "type": "string",
              "minLength": 1
            },
            "timeZone": {
              "type": "string",
              "minLength": 1
            },
            "timeZoneLabel": {
              "type": "string",
              "minLength": 1
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "pdf",
            "downloadName"
          ],
          "properties": {
            "image": {
              "$ref": "#/$defs/localImage"
            },
            "pdf": {
              "$ref": "#/$defs/localPdf"
            },
            "downloadName": {
              "type": "string",
              "pattern": "\\.pdf$"
            },
            "docx": {
              "$ref": "#/$defs/localDocx",
              "description": "Optional Word copy of the same resume, offered next to the PDF in the preview and saved under downloadName with a .docx extension."
            }
          },
          "description": "Author resume files and download name. Referenced source files must exist even when the feature is disabled; disabled resume files are excluded from publication unless another published item references them."
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "socialPreview",
            "icon",
            "appleTouchIcon"
          ],
          "properties": {
            "socialPreview": {
              "$ref": "#/$defs/localImage",
              "description": "Local Open Graph/social preview asset under public/. Prefer a 1200x630 PNG, JPEG, or WebP for broad crawler compatibility."
            },
            "icon": {
              "$ref": "#/$defs/localIcon",
              "description": "Primary browser/favicon asset under public/. Clean mode uses a neutral SVG placeholder until you replace it."
            },
            "appleTouchIcon": {
              "$ref": "#/$defs/localImage",
              "description": "Apple touch icon under public/. Prefer a 180x180 PNG before publishing."
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weather",
        "about",
        "work",
        "photography",
        "resume",
        "demoRoutes"
      ],
      "properties": {
        "weather": {
          "type": "boolean",
          "description": "Show weather next to local time and enable /api/weather."
        },
        "about": {
          "type": "boolean",
          "description": "Render the About section and its navigation entry."
        },
        "work": {
          "type": "boolean",
          "description": "Render enabled projects and the Work navigation entry."
        },
        "photography": {
          "type": "boolean",
          "description": "Render the photography gallery and its navigation entry."
        },
        "resume": {
          "type": "boolean",
          "description": "Enable the interactive resume printer and require configured resume files."
        },
        "demoRoutes": {
          "type": "boolean",
          "description": "Expose bundled example detail/blog/privacy routes and the demo-only podcast API."
        }
      },
      "description": "Feature switches for optional homepage sections and bundled example routes."
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "greetings",
        "portraits",
        "roleLine",
        "summary"
      ],
      "properties": {
        "greetings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "portraits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/localImage"
          },
          "description": "One or more local portrait images. Clicking the hero card rotates through them."
        },
        "roleLine": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/richTextSegment"
          },
          "description": "Rich inline hero role line. Segments can be plain text or a brand with icon."
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/richTextSegment"
          },
          "description": "Rich inline hero summary. Segments can be plain text or a brand with icon."
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline",
        "story",
        "galleryImages"
      ],
      "properties": {
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "title",
              "desc"
            ],
            "properties": {
              "year": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              },
              "current": {
                "type": "boolean",
                "description": "Explicit current role; independent of the calendar year."
              }
            }
          }
        },
        "story": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tone",
                "text"
              ],
              "properties": {
                "tone": {
                  "enum": [
                    "muted",
                    "strong",
                    "highlight"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        },
        "galleryImages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaAsset"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "description": "Ordered project list. Add, remove, reorder, or disable projects without editing React components."
    },
    "photography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro",
        "images"
      ],
      "properties": {
        "intro": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaAsset"
          }
        }
      }
    },
    "blog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Blog title used for metadata and as the default visible heading."
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "description": "Optional visible heading when the editorial heading differs from the metadata title."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "array",
          "description": "Optional rich intro. When omitted, description is rendered as plain text.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "tone": {
                "enum": [
                  "highlight"
                ]
              }
            }
          }
        }
      }
    },
    "footerBook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "quote",
        "author"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "keywords",
        "knowsAbout",
        "caseStudiesDescription"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The home page's title in search results and shared links. Built from the name and role when omitted."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Primary site description used for metadata, Open Graph, Twitter, Manifest, and Person JSON-LD."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Search keywords for the root portfolio page."
        },
        "knowsAbout": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Topics included in Person structured data."
        },
        "award": {
          "type": "string",
          "description": "Optional personal/site award. Remove when not applicable."
        },
        "caseStudiesDescription": {
          "type": "string"
        }
      },
      "description": "Root metadata and structured-data content derived into Next.js SEO outputs."
    },
    "interlude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "returnTitle",
        "handwrittenTitle",
        "returnDescription",
        "image"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "returnTitle": {
          "type": "string",
          "minLength": 1
        },
        "handwrittenTitle": {
          "type": "string",
          "minLength": 1
        },
        "returnDescription": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/$defs/localImage"
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locations"
      ],
      "description": "A shop or small business: its locations, how to reach it, what it sells and its service prices. Optional; store templates require it and personal templates ignore it.",
      "properties": {
        "tagline": {
          "type": "string",
          "description": "One line under the brand name, such as what the shop is."
        },
        "hoursSummary": {
          "type": "string",
          "minLength": 1,
          "description": "The hours on one line for the footer when every location keeps the same ones, such as Lun–sab 09:00–13:00 e 14:30–19:30, domenica chiuso. Built from the hours when omitted."
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phone": {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{6,14}$",
              "description": "Main phone for calls."
            },
            "displayPhone": {
              "type": "string",
              "description": "The phone as visitors read it, such as 300 123 4567."
            },
            "whatsapp": {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{6,14}$",
              "description": "WhatsApp number; visitors open a chat with it, optionally with a message already written."
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "links": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/storeLink"
              },
              "description": "Other channels such as TikTok, Instagram or a map."
            }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "city"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tagline": {
                "type": "string"
              },
              "note": {
                "type": "string",
                "description": "One sentence about this location for pages that list every location, such as the catalog."
              },
              "notes": {
                "type": "object",
                "additionalProperties": false,
                "description": "A sentence for one page alone, in place of note there: what this location offers for the catalog, or for the services.",
                "properties": {
                  "catalog": { "type": "string", "minLength": 1 },
                  "services": { "type": "string", "minLength": 1 }
                }
              },
              "street": {
                "type": "string",
                "description": "Street and number. Leave empty while unknown: pages then invite visitors to ask, and no map link is made."
              },
              "postalCode": {
                "type": "string"
              },
              "city": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "string",
                "description": "Province, state or region code."
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "description": "ISO 3166-1 alpha-2 code, such as IT."
              },
              "hours": {
                "type": "string",
                "description": "Opening hours as visitors read them."
              },
              "openingHours": {
                "type": "array",
                "description": "Opening hours in a form machines can read: lets a template say whether the shop is open now and publish them in structured data. Times use the site time zone (site.location.timeZone); several entries per day describe a lunch break.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "days",
                    "opens",
                    "closes"
                  ],
                  "properties": {
                    "days": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "mo",
                          "tu",
                          "we",
                          "th",
                          "fr",
                          "sa",
                          "su"
                        ]
                      }
                    },
                    "opens": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "closes": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    }
                  }
                }
              },
              "phone": {
                "type": "string",
                "pattern": "^\\+[1-9][0-9]{6,14}$",
                "description": "This location's own phone, if it publishes one."
              },
              "primary": {
                "type": "boolean",
                "description": "The location visitors contact first."
              },
              "highlights": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "What a visitor finds here, in plain words."
              },
              "image": {
                "$ref": "#/$defs/localImage"
              },
              "imageAlt": {
                "type": "string",
                "description": "What the photo shows, for screen readers."
              },
              "imageCredit": {
                "type": "string",
                "description": "Credit shown on the photo when its source requires one, such as Foto: Google Maps."
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/storeLink"
                }
              },
              "mapName": {
                "type": "string",
                "description": "The name this location goes by on maps, when it differs from its name here."
              }
            }
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "categories"
          ],
          "description": "Kinds of products, without prices or stock. A store template may give it its own page.",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "intro": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/localImage"
            },
            "imageAlt": {
              "type": "string"
            },
            "cardTitle": {
              "type": "string",
              "description": "Shorter title for this page's card on the home page; the title when omitted."
            },
            "cardText": {
              "type": "string",
              "description": "Shorter text for this page's card on the home page; the intro when omitted."
            },
            "imageLabel": {
              "type": "string",
              "description": "A short label shown on the picture, such as that it is illustrative."
            },
            "note": {
              "type": "string"
            },
            "categories": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "image": {
                    "$ref": "#/$defs/localImage"
                  }
                }
              }
            }
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "groups"
          ],
          "description": "Services with reference prices, such as a tailoring price list. A store template may give it its own page.",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "intro": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/localImage"
            },
            "imageAlt": {
              "type": "string"
            },
            "cardTitle": {
              "type": "string",
              "description": "Shorter title for this page's card on the home page; the title when omitted."
            },
            "cardText": {
              "type": "string",
              "description": "Shorter text for this page's card on the home page; the intro when omitted."
            },
            "imageLabel": {
              "type": "string",
              "description": "A short label shown on the picture, such as that it is illustrative."
            },
            "note": {
              "type": "string",
              "description": "Shown with the prices, such as that they are indicative."
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "items"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "price"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "price": {
                          "type": "string",
                          "minLength": 1
                        },
                        "note": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the site is hosted. `provider` is the default target of `npm run deploy`; each provider keeps its own settings side by side, so switching is one word. See docs/DEPLOYMENT.md.",
      "required": ["provider", "providers"],
      "properties": {
        "provider": {
          "enum": ["vercel", "cloudflare", "firebase"]
        },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "vercel": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "project": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "origin": {
                  "$ref": "#/$defs/hostingOrigin"
                }
              }
            },
            "cloudflare": {
              "type": "object",
              "additionalProperties": false,
              "required": ["accountId", "worker"],
              "properties": {
                "accountId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "worker": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                  "description": "The Worker's name; it serves at https://<worker>.<account subdomain>.workers.dev."
                },
                "origin": {
                  "$ref": "#/$defs/hostingOrigin"
                }
              }
            },
            "firebase": {
              "type": "object",
              "additionalProperties": false,
              "required": ["projectId"],
              "properties": {
                "projectId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
                },
                "site": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "description": "Hosting site; the project's default site when omitted."
                },
                "origin": {
                  "$ref": "#/$defs/hostingOrigin"
                }
              }
            }
          }
        },
        "redirects": {
          "type": "array",
          "description": "Old addresses that move permanently to new ones on every host, so links and search results that still point at them keep working.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^/[^/\\\\\\s?#%:*]+(?:/[^/\\\\\\s?#%:*]+)*$",
                "description": "The old path, without a trailing slash; not the home page."
              },
              "to": {
                "type": "string",
                "pattern": "^/(?!/)[^\\\\\\s?%:*]*$",
                "description": "Where it now lives on this site; may end in a #section."
              },
              "subpaths": {
                "type": "boolean",
                "description": "Also move every address under `from` to `to`."
              }
            }
          }
        }
      }
    },
    "plugins": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "slot": {
            "enum": [
              "site.floating",
              "site.footer",
              "article.after"
            ]
          },
          "options": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
