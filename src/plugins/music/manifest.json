{
  "id": "music",
  "name": "Music player",
  "description": "A persistent player, started by the visitor or on arrival, with configurable skins, docking, covers and optional notes.",
  "setupHelp": "Configure local audio or HTTPS direct URLs in a JSON options file (see docs/PLUGINS.md).",
  "version": "1.2.0",
  "apiVersion": 1,
  "entry": "player.tsx",
  "slots": ["site.floating"],
  "optionsSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tracks"],
    "properties": {
      "label": {
        "type": "string",
        "minLength": 1
      },
      "tracks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "src"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "artist": {
              "type": "string"
            },
            "src": {
              "type": "string",
              "anyOf": [
                {
                  "pattern": "^/portfolio/(?!.*(?:\\.\\.|//|[\\\\%?#\\s:]))[a-zA-Z0-9_./-]+\\.(mp3|m4a|ogg|wav|aac|flac)$",
                  "type": "string"
                },
                {
                  "format": "https-url",
                  "type": "string"
                }
              ],
              "tsType": "string"
            },
            "cover": {
              "type": "string",
              "anyOf": [
                {
                  "pattern": "^/portfolio/(?!.*(?:\\.\\.|//|[\\\\%?#\\s:]))[a-zA-Z0-9_./-]+\\.(avif|gif|jpg|jpeg|png|webp|svg)$",
                  "type": "string"
                },
                {
                  "format": "https-url",
                  "type": "string"
                }
              ],
              "tsType": "string"
            }
          },
          "title": "MusicTrack"
        },
        "uniqueBy": "id"
      },
      "skin": {
        "enum": ["capsule", "square"],
        "default": "capsule"
      },
      "position": {
        "enum": ["right", "bottom"],
        "default": "right"
      },
      "theme": {
        "enum": ["graphite", "porcelain", "cobalt"],
        "default": "graphite",
        "x-accents": {
          "graphite": "#ececf0",
          "porcelain": "#333338",
          "cobalt": "#d9dfe9"
        }
      },
      "accent": {
        "$ref": "#/$defs/color"
      },
      "initialExpanded": {
        "type": "boolean",
        "default": false
      },
      "autoplay": {
        "type": "boolean",
        "default": false,
        "description": "Start the first track on arrival. Browsers that withhold sound until the visitor has touched the page start it on their first press instead."
      },
      "offsetBottom": {
        "type": "integer",
        "minimum": 0,
        "maximum": 240,
        "description": "Bottom spacing in pixels, allowing the plugin to clear existing site controls without moving them."
      },
      "volume": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.7
      },
      "notes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "colors": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "$ref": "#/$defs/color"
            },
            "default": ["#cf8750", "#ac719b", "#528ba6"]
          }
        },
        "default": {}
      }
    },
    "$defs": {
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "title": "MusicOptions"
  },
  "networkOptions": {
    "media-src": ["tracks.*.src"],
    "img-src": ["tracks.*.cover"]
  },
  "generateOptions": true
}
