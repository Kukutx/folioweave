{
  "id": "pond",
  "name": "Pond",
  "description": "A garden pond seen from the bridge: on the home page koi you can feed, lily pads you can move and a day/night switch; projects shown as koi in viewing bowls, photographs that surface as they scroll in, and writing on the bank.",
  "translations": {
    "zh": {
      "description": "从桥上俯看的庭院池塘：首页可以喂锦鲤、拨动睡莲叶，还能切换白天和夜晚；作品像锦鲤展那样一条鱼一个圆盆，照片随滚动从水里浮上来，文章写在岸边。"
    }
  },
  "version": "2.0.0",
  "apiVersion": 1,
  "entries": {
    "Layout": "layout.tsx",
    "Home": "home.tsx",
    "BlogIndex": "blog-index.tsx",
    "BlogPost": "blog-post.tsx",
    "BlogTag": "blog-tag.tsx",
    "NotFound": "not-found.tsx"
  },
  "pages": [
    {
      "id": "projects",
      "entry": "projects.tsx",
      "path": "projects",
      "pathOption": "projectsPath",
      "requires": "projects"
    },
    {
      "id": "gallery",
      "entry": "gallery.tsx",
      "path": "gallery",
      "pathOption": "galleryPath",
      "requires": "photography.images"
    }
  ],
  "slots": ["site.floating", "site.footer", "article.after"],
  "sections": ["home", "work", "photography"],
  "optionsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "motto": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": "Up to three short lines in italic above the greeting; omitted by default."
      },
      "time": {
        "type": "string",
        "enum": ["auto", "day", "night"],
        "default": "auto",
        "description": "The time of day the site opens in: the visitor's system setting (auto), or always day or night until the visitor switches."
      },
      "projectsPath": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
        "default": "projects",
        "description": "Address of the projects page."
      },
      "galleryPath": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
        "default": "gallery",
        "description": "Address of the photography page."
      },
      "labels": {
        "type": "object",
        "additionalProperties": false,
        "description": "Interface wording, in plain English by default.",
        "properties": {
          "home": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Pond",
            "description": "The home page in the list of pages at the foot of the other pages."
          },
          "projects": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Work"
          },
          "gallery": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Photographs"
          },
          "blog": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "The writing in the navigation; the profile's blog title by default."
          },
          "light": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Day"
          },
          "dark": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Night"
          },
          "timeOfDay": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Time of day",
            "description": "Accessible name of the Day / Night switch."
          },
          "greeting": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "default": "{hello}, I'm {name}.",
            "description": "The greeting on the pond; {hello} is the first of the profile's greetings and {name} its first name."
          },
          "pond": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "default": "Feed the koi",
            "description": "Accessible name of the pond, a button that drops food on the water."
          },
          "hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "default": "Touch the water to feed the koi",
            "description": "The hint at the lower right of the pond until the visitor has fed the koi."
          },
          "minutes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "default": "min read"
          },
          "allTopics": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "All"
          },
          "back": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Back to the pond"
          },
          "notFound": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "default": "This page wandered off."
          },
          "skip": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Skip to content"
          },
          "close": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Close"
          },
          "previous": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Previous"
          },
          "next": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Next"
          }
        }
      }
    }
  },
  "preview": "preview.webp"
}
