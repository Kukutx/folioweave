{
  "id": "stack",
  "name": "Stack",
  "description": "One person's pile of paper on a desk: a calling card with a pile of portraits, the story on a ruled card, the years as index cards, the work as a deck of boards to deal and turn over, a contents sheet, loose prints to spread out and calling cards to take.",
  "translations": {
    "zh": {
      "description": "一个人摊在桌上的一叠纸：带一叠头像照片的名片、写在横线卡上的自我介绍、按年份排的索引卡、可以翻牌和翻面的作品板、一页文章目录、可以摊开的照片，和能拿走一张的名片。"
    }
  },
  "version": "2.0.0",
  "apiVersion": 1,
  "entries": {
    "Layout": "layout.tsx",
    "Home": "home.tsx",
    "BlogIndex": "blog-index.tsx",
    "BlogPost": "blog-post.tsx",
    "BlogTag": "blog-tag.tsx",
    "NotFound": "not-found.tsx"
  },
  "slots": ["site.floating", "site.footer", "article.after"],
  "sections": ["about", "work", "writing", "photography", "contact"],
  "optionsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "labels": {
        "type": "object",
        "additionalProperties": false,
        "description": "Interface wording; everything else on the page comes from the profile.",
        "properties": {
          "about": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "About",
            "description": "The tab of the about section (the story and the timeline)."
          },
          "work": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Work",
            "description": "The tab of the deck of projects."
          },
          "writing": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Writing",
            "description": "The tab of the latest articles, also the writing pages' tab."
          },
          "photography": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Photos",
            "description": "The tab of the prints."
          },
          "contact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Contact",
            "description": "The tab of the calling cards."
          },
          "sections": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Sections",
            "description": "The accessible name of the row of tabs."
          },
          "now": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Now",
            "description": "The stamp on the timeline's current card."
          },
          "previous": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Previous",
            "description": "The deck's button that lays the bottom board on top."
          },
          "next": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Next",
            "description": "The deck's button that tucks the top board under."
          },
          "turnOver": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Turn over",
            "description": "The deck's button that shows a board's back."
          },
          "turnBack": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Turn back",
            "description": "The same button while the back is showing."
          },
          "nextPortrait": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Next photo",
            "description": "The accessible name of the pile of portraits."
          },
          "spread": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Spread them out",
            "description": "The button that lays the prints out as a contact sheet."
          },
          "gather": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Pile them up",
            "description": "The button that piles the prints up again."
          },
          "shotWith": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Shot with",
            "description": "Put before the camera under the prints."
          },
          "morePhotos": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "More photos",
            "description": "The link to the profile's Instagram under the prints."
          },
          "write": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Write",
            "description": "The calling cards' e-mail button."
          },
          "copy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Copy address",
            "description": "The button that copies the e-mail address."
          },
          "copied": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Copied",
            "description": "Shown once the address is copied."
          },
          "resume": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Résumé",
            "description": "The résumé link on the calling card."
          },
          "minutes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "min",
            "description": "After an article's reading time."
          },
          "allWriting": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "All writing",
            "description": "The link to every article."
          },
          "home": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Home",
            "description": "The writing pages' tab back to the home page."
          },
          "backToTop": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Back to top",
            "description": "The footer's link."
          },
          "notFoundTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "Nothing here.",
            "description": "The 404 card's title."
          },
          "notFoundText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "The link may be outdated, or the page has moved.",
            "description": "The 404 card's text."
          }
        }
      },
      "camera": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "What the photographs were taken with, shown under the prints after the shotWith label."
      },
      "ending": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote"],
        "description": "The quote on the slip of paper beside the calling cards. Defaults to the profile's footerBook quote; omitted when neither exists.",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    }
  },
  "preview": "preview.webp"
}
